# Required Admin access configuration. Set unique values in server/.env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional WhatsApp Cloud API. Keep the access token server-side; use a rotated permanent/system-user token.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1320853654451968
WHATSAPP_API_VERSION=v22.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# Map internal template keys to names approved in WhatsApp Manager.
WHATSAPP_TEMPLATE_NAMES={"order_placed":"order_processing","payment_received":"royal_payment_received","delivered":"royal_order_delivered"}
# Required when sending royal_payment_received; use the delivery estimate your store promises.
WHATSAPP_DELIVERY_TIME=24 hours
PUBLIC_SITE_URL=https://your-store.example