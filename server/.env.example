# Required Admin access configuration. Set unique values in server/.env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional WhatsApp Cloud API. Use a permanent/system-user token and a registered phone number ID.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Map internal template keys to names approved in WhatsApp Manager.
WHATSAPP_TEMPLATE_NAMES={"order_placed":"order_placed","order_status_updated":"order_status_updated","order_cancelled":"order_cancelled","out_of_stock":"out_of_stock","payment_received":"payment_received","out_for_delivery":"out_for_delivery","delivered":"delivered"}
PUBLIC_SITE_URL=https://your-store.example